    std::cout << "\nFetching real-time data for " << city << "..." << std::endl;
    std::string jsonResponse = fetchWeatherData(url);

    if (jsonResponse.empty() || jsonResponse.find("\"cod\":404") != std::string::npos) {
        std::cout << "Error: Invalid city name or failed to connect to API." << std::endl;
        return 1;
    }

    
    std::string temp = extractJsonValue(jsonResponse, "temp");
    std::string humidity = extractJsonValue(jsonResponse, "humidity");
    std::string windSpeed = extractJsonValue(jsonResponse, "speed");
    std::string pressure = extractJsonValue(jsonResponse, "pressure");

    
    std::cout << "\n========================================" << std::endl;
    std::cout << "          WEATHER REPORT: " << city     << std::endl;
    std::cout << "========================================" << std::endl;
    std::cout << " Temperature : " << temp << " °C"       << std::endl;
